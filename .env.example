# News Intelligence Hub - environment template.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
# Every variable the stack reads is listed here. No real secrets in this file.

# === Project ===
# Compose project name - prefixes containers, networks, and volumes.
COMPOSE_PROJECT_NAME=nih
# development | production
NODE_ENV=development
# error | warn | info | debug
LOG_LEVEL=debug

# === Postgres ===
POSTGRES_VERSION=17
DB_NAME=nih
DB_USER=nih
# REQUIRED - compose refuses to start without it. Use a strong value.
DB_PASSWORD=change_me_in_env
# Host port for local DB tools (dev only). Container port is always 5432.
DB_PORT=5432

# === Redis ===
REDIS_VERSION=7
# Host port for local Redis tools (dev only). Container port is always 6379.
REDIS_PORT=6379

# === Backend API ===
# Container listen port (do not change unless you also change the healthchecks).
BACKEND_PORT=3000
# Host port the API is published on in dev -> http://localhost:3001
BACKEND_HOST_PORT=3001
# CORS allow-list. "*" for local dev; comma-separated origins in prod.
ALLOWED_ORIGINS=*

# === Frontend ===
# Host port the app is published on in dev -> http://localhost:3000
FRONTEND_HOST_PORT=3000
# How the frontend container reaches the API over the Docker network.
BACKEND_INTERNAL_URL=http://backend:3000

# === Worker ===
# BullMQ worker concurrency (per worker process).
WORKER_CONCURRENCY=5
# Port the worker's internal health endpoint listens on (container-only).
WORKER_HEALTH_PORT=3000

# === Bull Board (queue monitor, US-12) ===
# Container listen port for the panel.
BULL_BOARD_PORT=3001
# Host port the panel is published on in dev -> http://localhost:3002
BULL_BOARD_HOST_PORT=3002
# Basic-auth credentials for the panel. REQUIRED - panel exits without a password.
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change_me_in_env

# === LLM (used from Slice 4 onward; queue-only, never from HTTP handlers) ===
# Active provider: openai | anthropic
LLM_PROVIDER=anthropic
# Model id for the active provider.
LLM_MODEL=claude-haiku-4-5-20251001
# Provider API keys - fill the one you use; leave the other blank. Secrets: env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Max concurrent in-flight LLM calls across the worker pool.
LLM_CONCURRENCY=2
# Per-request output token cap.
LLM_MAX_TOKENS=1024
# Per-request timeout in milliseconds.
LLM_TIMEOUT_MS=30000

# === Pipeline tuning (deterministic pre-filter, FR-4) ===
# Minimum article body length (chars) to pass the pre-filter; shorter -> filtered.
PREFILTER_MIN_LENGTH=200
# Cron for the scheduled feed-pull worker.
FEED_PULL_CRON=*/15 * * * *

# === Auth (used from Slice 1 onward) ===
# Secret for signing session/JWT tokens. Secrets: env only.
JWT_SECRET=change_me_in_env
# Lifetime of an issued session/JWT (used from Slice 1.3 for login).
JWT_TTL=7d
# Session cookie name and whether it is sent only over HTTPS (true in prod).
SESSION_COOKIE_NAME=nih_session
SESSION_COOKIE_SECURE=false
# Public base URL used to build the email-confirmation link (no trailing slash).
APP_BASE_URL=http://localhost:3000
# Dev mode surfaces the confirmation link in the API response + logs (no email
# transport yet). Set to "false" once a real transport exists.
DEV_MODE_CONFIRMATION=true
# Hours an email-confirmation token stays valid before it expires.
CONFIRMATION_TOKEN_TTL_HOURS=24
# Whether the API applies pending DB migrations on startup.
RUN_MIGRATIONS_ON_STARTUP=true

# === Password hashing (argon2id) ===
# Memory cost in KiB, iterations, and lanes. Defaults follow OWASP guidance.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# === Production only (uncomment for `docker-compose.prod.yml`) ===
# DOCKER_REGISTRY=ghcr.io/your-org
# VERSION=latest
# Public HTTP port the frontend binds in production.
# HTTP_PORT=80
