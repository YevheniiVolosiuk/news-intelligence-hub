{
  "name": "nih-backend",
  "version": "0.0.1",
  "private": true,
  "description": "News Intelligence Hub backend: NestJS API, BullMQ worker, and Bull Board panel. Skeleton stage - proves the stack boots and connects to Postgres and Redis.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "migrate": "NODE_OPTIONS='--import tsx/esm' node-pg-migrate --migrations-dir src/infra/database/migrations up",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nodemon --quiet --watch src --ext ts --exec \"ts-node src/worker.ts\"",
    "board": "node dist/bull-board.js",
    "board:dev": "nodemon --quiet --watch src --ext ts --exec \"ts-node src/bull-board.ts\"",
    "seed:demo": "tsx src/infra/database/seed-demo.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.5.0",
    "@bull-board/express": "^6.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.1",
    "express-basic-auth": "^1.2.1",
    "fast-xml-parser": "^5.8.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "gts": "^7.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
