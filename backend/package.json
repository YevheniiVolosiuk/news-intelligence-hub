{
  "name": "nih-backend",
  "version": "0.0.1",
  "private": true,
  "description": "News Intelligence Hub backend: NestJS API, BullMQ worker, and Bull Board panel. Skeleton stage - proves the stack boots and connects to Postgres and Redis.",
  "scripts": {
    "build": "nest build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nodemon --quiet --watch src --ext ts --exec \"ts-node src/worker.ts\"",
    "board": "node dist/bull-board.js",
    "board:dev": "nodemon --quiet --watch src --ext ts --exec \"ts-node src/bull-board.ts\""
  },
  "dependencies": {
    "@bull-board/api": "^6.5.0",
    "@bull-board/express": "^6.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^5.34.0",
    "express": "^5.0.1",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.4",
    "gts": "^7.0.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
